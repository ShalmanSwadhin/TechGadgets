# ---- API ----
# Base URL for API requests. Leave as "/api" to use the Vite dev proxy locally
# and same-origin/rewrites in production. Set to the full backend URL only if
# the frontend calls the API cross-origin (e.g. https://api.techgadgets.com/api).
VITE_API_URL=/api

# Dev-only: where the Vite proxy forwards "/api" during `npm run dev`.
# Not used in the production build. Optional; defaults to http://127.0.0.1:5000.
VITE_API_TARGET=http://127.0.0.1:5000

# ---- Store branding (all optional; sensible defaults exist in code) ----
VITE_STORE_NAME=TechGadgets
VITE_STORE_TAGLINE=Build In Services
VITE_STORE_EMAIL=hello@techgadgets.store
VITE_STORE_PHONE=01300733439
VITE_STORE_ADDRESS=Shonir Akhra, Dhaka-1236
VITE_STORE_WHATSAPP=8801300733439
