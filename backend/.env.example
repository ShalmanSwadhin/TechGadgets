# ---- Server ----
# Port the API listens on (Render sets this automatically). Optional; defaults to 5000.
PORT=5000
# "development" or "production". Controls request logging and error-stack exposure.
NODE_ENV=development

# ---- Database (required) ----
# MongoDB Atlas connection string. Include the database name before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/techgadgets?retryWrites=true&w=majority

# ---- Auth (JWT_SECRET required) ----
# Long random string used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime. Optional; defaults to 7d.
JWT_EXPIRE=7d

# ---- CORS ----
# Allowed frontend origin(s). Single origin or a comma-separated allow-list,
# e.g. https://techgadgets.vercel.app,https://www.techgadgets.com
# In development, include BOTH localhost and 127.0.0.1 — browsers treat them
# as different origins, and a mismatch here silently 500s every non-GET
# request (login, checkout, cart, admin) with a CORS error while GET
# requests keep working, which makes it a confusing bug to track down.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# ---- Cloudinary (required for image uploads) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- Admin bootstrap (optional) ----
# Only read by "npm run create-admin" when you don't pass CLI arguments.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
# ADMIN_NAME=Admin
